cards[5]{"id": "card_001", "category": "news", "difficulty": "medium", "front": "What is the primary concern raised by the recent departure of radiologists from a CT hospital?", "back": "The significant number of radiologists leaving raises concerns about potential impacts on patient care and healthcare access due to workforce shortages.", "source": "courant.com", "tags": "workforce;radiology;access;patient care;staffing"};
cards[1]{"id": "card_002", "category": "research", "difficulty": "hard", "front": "What biological process were researchers focused on understanding in their recent cancer evolution study?", "back": "The hidden rules governing chromosome gains and losses in cancer cells, revealing how tumors evolve and adapt to treatment.", "source": "ScienceDaily Health", "tags": "cancer evolution;genetics;tumor biology;therapeutic targets"};
cards[2]{"id": "card_003", "category": "research", "difficulty": "medium", "front": "What technology is being utilized in a study aiming to restore movement in paralyzed patients?", "back": "A brain-computer interface system utilizing EEG signals and spinal stimulation.", "source": "ScienceDaily Health", "tags": "brain-computer interface;neurorehabilitation;paralysis;EEG;spinal stimulation"};
cards[3]{"id": "card_004", "category": "research", "difficulty": "medium", "front": "According to a recent study, what is a potential long-term health consequence associated with childhood ADHD traits?", "back": "An increased risk of multiple physical health problems and disability in midlife.", "source": "ScienceDaily Health", "tags": "ADHD;neurodevelopmental;longitudinal study;physical health;midlife consequences"};
cards[4]{"id": "card_005", "category": "news", "difficulty": "easy", "front": "What is the emerging global health concern highlighted in the news digest?", "back": "The spreading of free-living amoebae, which can harbor dangerous bacteria and pose a growing public health threat.", "source": "ScienceDaily Health", "tags": "global health;amoebas;public health;infection;emerging threats"};

